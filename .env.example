# AI Prototype Generator - Server Environment Configuration
# Copy this to /server/.env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=5001
NODE_ENV=development

# ============================================
# Gemini AI Configuration (Required)
# Get your API key from: https://aistudio.google.com/
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# CORS Configuration
# In development: http://localhost:5173
# In production:  https://your-frontend-domain.vercel.app
# You can add multiple origins separated by commas:
# CORS_ORIGIN=https://your-app.vercel.app,https://custom-domain.com
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# MongoDB (Optional - for session persistence)
# Leave blank to run without DB
# ============================================
MONGODB_URI=
