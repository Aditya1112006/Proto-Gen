# ProtoGen Frontend Environment Configuration
# Copy this file to /client/.env and fill in your values

# ============================================
# API Configuration (Required for production)
# In development: leave blank (defaults to http://localhost:5001)
# In production:  set to your deployed backend URL
# e.g. https://your-backend.onrender.com
# ============================================
VITE_API_URL=http://localhost:5001
