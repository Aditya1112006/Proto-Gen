# ============================================================
# Proto-Gen Server — Environment Configuration
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in YOUR values below
#   3. NEVER commit the .env file — it is git-ignored
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------
# Gemini AI (Required)
# Get your key: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# MongoDB Atlas (Required)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# ------------------------------------------------------------
MONGO_URI=your_mongodb_connection_string_here

# MongoDB Atlas Vector Search index name
# Create this index in the Atlas UI before using RAG features
ATLAS_VECTOR_INDEX=vector_index

# ------------------------------------------------------------
# JWT Authentication
# Use a long, random string — never share this
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# CORS
# Development:  http://localhost:3000
# Production:   https://your-frontend-domain.vercel.app
# Multiple:     https://app.vercel.app,https://custom.com
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
