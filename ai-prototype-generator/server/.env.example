# Server Configuration
PORT=5001
NODE_ENV=development

# OpenAI API
# For OpenAI: https://platform.openai.com/api-keys
# For Groq: https://console.groq.com/keys (faster, free tier available)
OPENAI_API_KEY=your_api_key_here

# Model Configuration
# OpenAI models: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Groq models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma-7b-it
OPENAI_MODEL=gpt-4o-mini

# Optional: Use Groq's OpenAI-compatible API for faster/cheaper inference
# Uncomment to use Groq instead of OpenAI:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# CORS
CORS_ORIGIN=http://localhost:5173
